{
  "template": "invoice_generic",
  "mode": "dynamic",
  "extends": "invoice",
  "identify": {
    "fallback": true,
    "fallback_detect": ["发票"]
  },
  "_comment": "通用兜底模板：专属模板全部淘汰时启用。fallback_detect 为弱关键词守卫，页面文本不含『发票』时不套用（避免误用于合同/其他文档）。识别为 fallback 的文档会降低 identify 置信度并进入人工复核；候选锚点/表头覆盖更多版式写法（货物或应税劳务、服务名称、统一社会信用代码等），明细同样走 Table Engine。字段类型与公共 regions/table 继承 templates/base/invoice.json。",
  "variants": {
    "construction": {
      "detect": {
        "must": ["建筑服务发生地", "建筑项目名称"]
      },
      "required_fields": ["construction_site", "project_name"]
    }
  },
  "fields": {
    "invoice_no": {
      "page": 0,
      "region": "header",
      "anchor": "发票号码",
      "direction": "right",
      "verify": true
    },
    "invoice_date": {
      "page": 0,
      "region": "header",
      "anchor": "开票日期",
      "direction": "right",
      "verify": true
    },
    "buyer_name": {
      "page": 0,
      "region": "header",
      "anchor": ["名称：", "名称:"],
      "direction": "right",
      "x_max": 300,
      "verify": true
    },
    "buyer_tax_no": {
      "page": 0,
      "region": "header",
      "anchor": ["纳税人识别号", "统一社会信用代码"],
      "direction": "right",
      "x_max": 300,
      "verify": true
    },
    "seller_name": {
      "page": 0,
      "region": "header",
      "anchor": ["名称：", "名称:"],
      "direction": "right",
      "x_min": 300,
      "verify": true
    },
    "seller_tax_no": {
      "page": 0,
      "region": "header",
      "anchor": ["纳税人识别号", "统一社会信用代码"],
      "direction": "right",
      "x_min": 300,
      "verify": true
    },
    "item_name": {
      "page": 0,
      "region": "items",
      "anchor": ["货物或应税劳务", "项目名称", "服务名称"],
      "direction": "below",
      "same_word": false,
      "max_distance": 30
    },
    "spec_model": {
      "page": 0,
      "region": "items",
      "anchor": "规格型号",
      "direction": "below",
      "max_distance": 30
    },
    "unit": {
      "page": 0,
      "region": "items",
      "anchor": ["单位", "单 位"],
      "direction": "below",
      "max_distance": 30,
      "anchor_span": true
    },
    "quantity": {
      "page": 0,
      "region": "items",
      "anchor": ["数量", "数 量"],
      "direction": "below",
      "max_distance": 30,
      "anchor_span": true
    },
    "unit_price": {
      "page": 0,
      "region": "items",
      "anchor": ["单价", "单 价"],
      "direction": "below",
      "max_distance": 30,
      "below_mode": "row",
      "anchor_span": true
    },
    "item_rows": {
      "page": 0,
      "region": "items",
      "anchor": ["项目名称", "货物或应税劳务", "服务名称"],
      "direction": "below",
      "below_mode": "count",
      "max_distance": 800,
      "stop_anchor": ["合 计", "合计", "价税合计", "建筑服务发生地", "建筑项目名称"]
    },
    "item_amount_rows": {
      "page": 0,
      "region": "items",
      "anchor": ["金额", "金 额", "金"],
      "anchor_span": true,
      "direction": "below",
      "below_mode": "count",
      "max_distance": 800,
      "stop_anchor": ["合 计", "合计", "价税合计"]
    },
    "item_tax_rows": {
      "page": 0,
      "region": "items",
      "anchor": ["税额", "税 额"],
      "anchor_span": true,
      "direction": "below",
      "below_mode": "count",
      "max_distance": 800,
      "stop_anchor": ["合 计", "合计", "价税合计"]
    },
    "construction_site": {
      "page": 0,
      "anchor": "建筑服务发生地",
      "direction": "below",
      "max_distance": 90,
      "below_mode": "merge",
      "stop_anchor": ["建筑项目名称", "合 计", "合计", "价税合计"]
    },
    "project_name": {
      "page": 0,
      "anchor": "建筑项目名称",
      "direction": "below",
      "max_distance": 90,
      "below_mode": "merge",
      "stop_anchor": ["合 计", "合计", "价税合计"]
    },
    "tax_rate": {
      "page": 0,
      "region": "items",
      "anchor": ["税率/征收率", "税率", "征收率"],
      "direction": "below",
      "max_distance": 30
    },
    "amount": {
      "page": 0,
      "region": "totals",
      "anchor": ["金额", "金 额", "金"],
      "anchor_span": true,
      "direction": "below",
      "max_distance": 800,
      "stop_anchor": ["（小写）"],
      "scope": {
        "end_anchor": ["（小写）", "(小写)", "价税合计"]
      },
      "below_mode": "row",
      "pick": "last",
      "verify": true
    },
    "tax_amount": {
      "page": 0,
      "region": "totals",
      "anchor": ["税额", "税 额", "税"],
      "anchor_span": true,
      "direction": "below",
      "max_distance": 800,
      "scope": {
        "end_anchor": ["（小写）", "(小写)", "价税合计"]
      },
      "below_mode": "row",
      "pick": "last",
      "verify": true
    },
    "total_amount": {
      "page": 0,
      "anchor": ["（小写）", "(小写)"],
      "direction": "right",
      "verify": true
    }
  }
}
