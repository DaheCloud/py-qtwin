{
  "template": "invoice_v2",
  "mode": "dynamic",
  "extends": "invoice",
  "_comment": "专属版式②：增值税专用发票数电票（明细表头含 规格型号/单位 列，无建筑服务信息块时也适用）。字段类型/正则/严重程度与公共 regions/table 配置继承 templates/base/invoice.json，这里只声明『怎么找』；variants 按 detect 切换：文档带建筑服务信息块时 construction_site/project_name 转必填。识别为文档指纹打分（文本+锚点位置+表头结构+页面特征）。",
  "variants": {
    "construction": {
      "detect": {
        "must": ["建筑服务发生地", "建筑项目名称"]
      },
      "required_fields": ["construction_site", "project_name"]
    }
  },
  "identify": {
    "priority": 10,
    "text": {
      "must": ["增值税专用发票"],
      "any": ["电子发票", "规格型号"]
    },
    "anchors": [
      {"text": "发票号码", "area": "top_right"}
    ],
    "table_headers": ["项目名称", "规格型号", "单位", "数量", "单价", "金额", "税率/征收率", "税额"],
    "page_size": [595.32, 841.92],
    "min_score": 60
  },
  "fields": {
    "invoice_no": {
      "page": 0,
      "region": "header",
      "anchor": "发票号码",
      "direction": "right",
      "verify": true
    },
    "invoice_date": {
      "page": 0,
      "region": "header",
      "anchor": "开票日期",
      "direction": "right",
      "verify": true
    },
    "buyer_name": {
      "page": 0,
      "region": "header",
      "anchor": "名称：",
      "direction": "right",
      "x_max": 300,
      "verify": true
    },
    "buyer_tax_no": {
      "page": 0,
      "region": "header",
      "anchor": "纳税人识别号",
      "direction": "right",
      "x_max": 300,
      "verify": true
    },
    "seller_name": {
      "page": 0,
      "region": "header",
      "anchor": "名称：",
      "direction": "right",
      "x_min": 300,
      "verify": true
    },
    "seller_tax_no": {
      "page": 0,
      "region": "header",
      "anchor": "纳税人识别号",
      "direction": "right",
      "x_min": 300,
      "verify": true
    },
    "item_name": {
      "page": 0,
      "region": "items",
      "anchor": "项目名称",
      "direction": "below",
      "max_distance": 30,
      "pattern": "^\\*.+\\*.+$",
      "verify": true
    },
    "spec_model": {
      "page": 0,
      "region": "items",
      "anchor": "规格型号",
      "direction": "below",
      "max_distance": 30
    },
    "unit": {
      "page": 0,
      "region": "items",
      "anchor": ["单位", "单 位"],
      "direction": "below",
      "max_distance": 30,
      "anchor_span": true
    },
    "quantity": {
      "page": 0,
      "region": "items",
      "anchor": ["数量", "数 量"],
      "direction": "below",
      "max_distance": 30,
      "anchor_span": true
    },
    "unit_price": {
      "page": 0,
      "region": "items",
      "anchor": ["单价", "单 价"],
      "direction": "below",
      "max_distance": 30,
      "below_mode": "row",
      "anchor_span": true
    },
    "item_rows": {
      "page": 0,
      "region": "items",
      "anchor": "项目名称",
      "direction": "below",
      "below_mode": "count",
      "max_distance": 800,
      "stop_anchor": ["合 计", "合计", "价税合计", "建筑服务发生地", "建筑项目名称"]
    },
    "item_amount_rows": {
      "page": 0,
      "region": "items",
      "anchor": ["金额", "金 额", "金"],
      "anchor_span": true,
      "direction": "below",
      "below_mode": "count",
      "max_distance": 800,
      "stop_anchor": ["合 计", "合计", "价税合计"]
    },
    "item_tax_rows": {
      "page": 0,
      "region": "items",
      "anchor": ["税额", "税 额"],
      "anchor_span": true,
      "direction": "below",
      "below_mode": "count",
      "max_distance": 800,
      "stop_anchor": ["合 计", "合计", "价税合计"]
    },
    "construction_site": {
      "page": 0,
      "fallback_policy": "document",
      "anchor": "建筑服务发生地",
      "direction": "below",
      "max_distance": 90,
      "below_mode": "merge",
      "stop_anchor": ["建筑项目名称", "合 计", "合计", "价税合计"]
    },
    "project_name": {
      "page": 0,
      "fallback_policy": "document",
      "anchor": "建筑项目名称",
      "direction": "below",
      "max_distance": 90,
      "below_mode": "merge",
      "stop_anchor": ["合 计", "合计", "价税合计"]
    },
    "tax_rate": {
      "page": 0,
      "region": "items",
      "anchor": ["税率/征收率", "税率", "征收率"],
      "direction": "below",
      "max_distance": 30,
      "verify": true
    },
    "total_amount": {
      "page": 0,
      "region": "totals",
      "anchor": ["（小写）", "(小写)"],
      "direction": "right",
      "verify": true
    },
    "amount": {
      "page": 0,
      "region": "totals",
      "anchor": ["金额", "金 额", "金"],
      "anchor_span": true,
      "direction": "below",
      "max_distance": 800,
      "stop_anchor": ["（小写）"],
      "scope": {
        "end_anchor": ["（小写）", "(小写)", "价税合计"]
      },
      "below_mode": "row",
      "pick": "last",
      "verify": true
    },
    "tax_amount": {
      "page": 0,
      "region": "totals",
      "anchor": ["税 额", "税额", "税"],
      "anchor_span": true,
      "direction": "below",
      "max_distance": 800,
      "scope": {
        "end_anchor": ["（小写）", "(小写)", "价税合计"]
      },
      "below_mode": "row",
      "pick": "last",
      "verify": true
    }
  }
}
